# Build output (the crate and every benchmark server).
target/
**/target/

# Editors and operating systems.
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Profiling and debugging leftovers.
callgrind.out.*
massif.out.*
perf.data*
vgcore.*
*.profraw

# Local setup helpers.
*.bundle
setup-git.cmd

# Python bytecode (site/build.py imports scripts/release.py).
__pycache__/

# The site's pages, generated when it deploys (python3 site/build.py).
site/public/*.html
site/public/*/index.html
site/public/llms.txt
site/public/llms-full.txt
site/public/robots.txt
site/public/sitemap.xml

# The Go benchmark server (bench/memory.sh builds it).
bench/go-http/bench-go-http
