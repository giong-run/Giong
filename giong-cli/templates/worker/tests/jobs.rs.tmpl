{{#if !db}}
#[test]
fn ticks_until_the_limit() {
    giong::block_on(async {
        assert_eq!({{crate}}::tick(7).await, "tick 7");
        let started = std::time::Instant::now();
        let count = {{crate}}::work(Duration::from_millis(10), Some(3)).await;
        assert_eq!(count, 3);
        assert!(started.elapsed() >= Duration::from_millis(30));
    });
}
