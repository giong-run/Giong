{{#if postgres}}

#[test]
fn jobs_from_the_table() {
    let Some(url) = setting("DATABASE_URL") else {
        eprintln!("SKIPPED: DATABASE_URL is not set (run giong db up, or set it)");
        return;
    };
    let queue = queue_name();
    giong::block_on(async {
        let db = giong_postgres::Pool::new(giong_postgres::Config::from_url(&url).unwrap(), 2);
        db.batch_execute({{crate}}::SCHEMA).await.unwrap();
        let ok = {{crate}}::enqueue(&db, &queue, r#"{"kind":"greet","name":"Ada"}"#)
            .await
            .unwrap();
        let bad = {{crate}}::enqueue(&db, &queue, r#"{"kind":"fly"}"#).await.unwrap();

        let first = {{crate}}::run_next(&db, &queue).await.unwrap();
        assert_eq!(first, Outcome::Done("Hello, Ada!".into()));
        let second = {{crate}}::run_next(&db, &queue).await.unwrap();
        assert!(matches!(second, Outcome::Failed(ref e) if e.contains("fly")), "{second:?}");
        // The failed job waits before its next attempt.
        assert_eq!({{crate}}::run_next(&db, &queue).await.unwrap(), Outcome::Idle);

        let row = db
            .query_one("SELECT state FROM jobs WHERE id = $1", &[&ok])
            .await
            .unwrap();
        assert_eq!(row.get::<&str>(0).unwrap(), "done");
        let row = db
            .query_one("SELECT state, attempts, last_error FROM jobs WHERE id = $1", &[&bad])
            .await
            .unwrap();
        assert_eq!(row.get::<&str>(0).unwrap(), "queued");
        assert_eq!(row.get::<i32>(1).unwrap(), 1);
        assert!(row.get::<&str>(2).unwrap().contains("no job of kind"));

        // After the last attempt it is set aside.
        db.execute(
            "UPDATE jobs SET attempts = $2, run_after = now() WHERE id = $1",
            &[&bad, &({{crate}}::MAX_ATTEMPTS - 1)],
        )
        .await
        .unwrap();
        assert!(matches!({{crate}}::run_next(&db, &queue).await.unwrap(), Outcome::Failed(_)));
        let row = db
            .query_one("SELECT state FROM jobs WHERE id = $1", &[&bad])
            .await
            .unwrap();
        assert_eq!(row.get::<&str>(0).unwrap(), "failed");
        assert_eq!({{crate}}::run_next(&db, &queue).await.unwrap(), Outcome::Idle);

        db.execute("DELETE FROM jobs WHERE queue = $1", &[&queue])
            .await
            .unwrap();
    });
}

#[test]
fn two_claimers_never_take_the_same_job() {
    let Some(url) = setting("DATABASE_URL") else {
        eprintln!("SKIPPED: DATABASE_URL is not set (run giong db up, or set it)");
        return;
    };
    let queue = queue_name();
    giong::block_on(async {
        let db = giong_postgres::Pool::new(giong_postgres::Config::from_url(&url).unwrap(), 4);
        db.batch_execute({{crate}}::SCHEMA).await.unwrap();
        for n in 0..20 {
            let job = format!(r#"{{"kind":"greet","name":"n{n}"}}"#);
            {{crate}}::enqueue(&db, &queue, &job).await.unwrap();
        }
        let mut claimers = Vec::new();
        for _ in 0..4 {
            let (db, queue) = (db.clone(), queue.clone());
            claimers.push(giong::spawn(async move {
                let mut done = Vec::new();
                while let Outcome::Done(r) = {{crate}}::run_next(&db, &queue).await.unwrap() {
                    done.push(r);
                }
                done
            }));
        }
        let mut all = Vec::new();
        for c in claimers {
            all.extend(c.await.unwrap());
        }
        all.sort();
        all.dedup();
        assert_eq!(all.len(), 20, "every job ran exactly once");
        db.execute("DELETE FROM jobs WHERE queue = $1", &[&queue])
            .await
            .unwrap();
    });
}
