{{#if mysql}}
pub async fn enqueue(
    db: &giong_mysql::Pool,
    queue: &str,
    payload: &str,
) -> Result<i64, giong_mysql::Error> {
    let id = db
        .insert(
            "INSERT INTO jobs (queue, payload) VALUES (?, ?)",
            &[&queue, &payload],
        )
        .await?
        .unwrap_or(0);
    Ok(id as i64)
}

/// Claims the oldest job that is due, runs it, and records the outcome.
pub async fn run_next(
    db: &giong_mysql::Pool,
    queue: &str,
) -> Result<Outcome, giong_mysql::Error> {
    // MySQL has no UPDATE ... RETURNING: the claim is a short transaction on
    // a connection of this task's own.
    let (id, payload, attempts) = {
        let mut conn = db.get().await?;
        let tx = conn.transaction().await?;
        let row = tx
            .query_opt(
                "SELECT id, payload, attempts FROM jobs
                 WHERE queue = ? AND state = 'queued' AND run_after <= UTC_TIMESTAMP(6)
                 ORDER BY id LIMIT 1 FOR UPDATE SKIP LOCKED",
                &[&queue],
            )
            .await?;
        let Some(row) = row else {
            tx.commit().await?;
            return Ok(Outcome::Idle);
        };
        let (id, payload, attempts): (i64, String, i32) =
            (row.get(0)?, row.get(1)?, row.get(2)?);
        tx.execute(
            "UPDATE jobs SET state = 'running', attempts = attempts + 1 WHERE id = ?",
            &[&id],
        )
        .await?;
        tx.commit().await?;
        (id, payload, attempts + 1)
    };
    match run_job(&payload) {
        Ok(result) => {
            db.execute("UPDATE jobs SET state = 'done' WHERE id = ?", &[&id])
                .await?;
            Ok(Outcome::Done(result))
        }
        Err(error) => {
            // Retried after 2, 4, 8... seconds, then set aside.
            let backoff = 1i64 << attempts.clamp(1, 20);
            db.execute(
                "UPDATE jobs SET last_error = ?,
                    state = IF(attempts >= ?, 'failed', 'queued'),
                    run_after = UTC_TIMESTAMP(6) + INTERVAL ? SECOND
                 WHERE id = ?",
                &[&error, &MAX_ATTEMPTS, &backoff, &id],
            )
            .await?;
            Ok(Outcome::Failed(error))
        }
    }
}
