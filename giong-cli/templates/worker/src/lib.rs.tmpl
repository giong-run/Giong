use std::time::Duration;

{{#if db}}
/// What a job asks for, as the JSON text that was queued:
/// `{"kind": "greet", "name": "Ada"}`.
///
/// Add your own kinds here. A job that returns an error is retried (or set
/// aside); one that panics stops its worker's loop, as any panic would.
pub fn run_job(payload: &str) -> Result<String, String> {
    let job: serde_json::Value =
        serde_json::from_str(payload).map_err(|e| format!("not JSON: {e}"))?;
    match job["kind"].as_str() {
        Some("greet") => {
            let name = job["name"]
                .as_str()
                .filter(|n| !n.is_empty())
                .ok_or("greet needs a name")?;
            Ok(format!("Hello, {name}!"))
        }
        Some(other) => Err(format!("no job of kind {other:?}")),
        None => Err("the job has no \"kind\"".into()),
    }
}

/// How a run of the loop went, for the log and the tests.
#[derive(Debug, PartialEq, Eq)]
pub enum Outcome {
    /// A job ran and succeeded.
    Done(String),
    /// A job ran and failed; it will be retried, or was set aside.
    Failed(String),
    /// Nothing was waiting.
    Idle,
}

{{/if}}
{{#if redis}}
/// Where the jobs wait, and where the failed ones go.
#[derive(Clone)]
pub struct Queue {
    pub pending: String,
    pub failed: String,
}

impl Queue {
    pub fn named(name: &str) -> Queue {
        Queue {
            pending: format!("jobs:{name}"),
            failed: format!("jobs:{name}:failed"),
        }
    }
}

/// Waits up to `wait` for a job on the list, runs it, and records a failure.
pub async fn run_next(
    conn: &mut giong_redis::Client,
    queue: &Queue,
    wait: Duration,
) -> Result<Outcome, giong_redis::Error> {
    use giong_redis::cmd;
    // BRPOP blocks the connection: it is this task's own (`Pool::take`).
    let popped: Option<(String, String)> = conn
        .query_blocking(&cmd("BRPOP").arg(&queue.pending).arg(wait.as_secs().max(1)))
        .await?;
    let Some((_list, payload)) = popped else {
        return Ok(Outcome::Idle);
    };
    match run_job(&payload) {
        Ok(result) => Ok(Outcome::Done(result)),
        Err(error) => {
            let record = serde_json::json!({ "job": payload, "error": error }).to_string();
            conn.query::<i64>(&cmd("LPUSH").arg(&queue.failed).arg(record))
                .await?;
            Ok(Outcome::Failed(error))
        }
    }
}

/// The loop of one worker, until the service is asked to stop. A Redis that
/// cannot be reached is retried every few seconds.
pub async fn work(pool: giong_redis::Pool, queue: Queue) {
    while !giong::is_shutting_down() {
        let mut conn = match giong::until_shutdown(pool.take()).await {
            None => return,
            Some(Ok(conn)) => conn,
            Some(Err(e)) => {
                eprintln!("{{name}}: redis: {e}; retrying in 5 s");
                let _ = giong::until_shutdown(giong::time::sleep(Duration::from_secs(5))).await;
                continue;
            }
        };
        loop {
            // Cancelling a blocking command closes its connection, so a
            // shutdown never leaves a job half taken.
            match giong::until_shutdown(run_next(&mut conn, &queue, Duration::from_secs(5))).await {
                None => return,
                Some(Ok(Outcome::Done(result))) => log("done", &result),
                Some(Ok(Outcome::Failed(error))) => log("failed", &error),
                Some(Ok(Outcome::Idle)) => {}
                Some(Err(e)) => {
                    eprintln!("{{name}}: redis: {e}");
                    break; // A fresh connection.
                }
            }
        }
    }
}
