{{#if !db}}
/// The work done every interval. Replace it with yours; keep it short or
/// give the other tasks a turn with `giong::yield_now().await`, since a long
/// computation holds up the worker it runs on.
pub async fn tick(count: u64) -> String {
    format!("tick {count}")
}

/// Runs `tick` every `interval` until the service is asked to stop, or
/// `limit` ticks when one is given (for tests).
pub async fn work(interval: Duration, limit: Option<u64>) -> u64 {
    let mut count = 0;
    while limit.map_or(true, |l| count < l) {
        if giong::until_shutdown(giong::time::sleep(interval)).await.is_none() {
            break;
        }
        count += 1;
        log("tick", &tick(count).await);
    }
    count
}
