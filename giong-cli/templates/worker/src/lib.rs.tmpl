/// After this many failed runs a job is set aside (`state = 'failed'`).
pub const MAX_ATTEMPTS: i32 = 5;

/// The tables, created at startup when they are missing.
pub const SCHEMA: &str = include_str!("../migrations/0001_init.sql");

/// Puts a job on a queue; returns its id.
{{/if}}
{{#if postgres}}
pub async fn enqueue(
    db: &giong_postgres::Pool,
    queue: &str,
    payload: &str,
) -> Result<i64, giong_postgres::Error> {
    let row = db
        .query_one(
            "INSERT INTO jobs (queue, payload) VALUES ($1, $2) RETURNING id",
            &[&queue, &payload],
        )
        .await?;
    row.get(0)
}

/// Claims the oldest job that is due, runs it, and records the outcome.
pub async fn run_next(
    db: &giong_postgres::Pool,
    queue: &str,
) -> Result<Outcome, giong_postgres::Error> {
    // One statement, so no transaction is needed: the row is locked, skipped
    // by every other claimer, and marked as running in one step.
    let claimed = db
        .query_opt(
            "UPDATE jobs SET state = 'running', attempts = attempts + 1
             WHERE id = (SELECT id FROM jobs
                         WHERE queue = $1 AND state = 'queued' AND run_after <= now()
                         ORDER BY id LIMIT 1 FOR UPDATE SKIP LOCKED)
             RETURNING id, payload, attempts",
            &[&queue],
        )
        .await?;
    let Some(row) = claimed else {
        return Ok(Outcome::Idle);
    };
    let (id, payload, attempts): (i64, &str, i32) = (row.get(0)?, row.get(1)?, row.get(2)?);
    match run_job(payload) {
        Ok(result) => {
            db.execute("UPDATE jobs SET state = 'done' WHERE id = $1", &[&id])
                .await?;
            Ok(Outcome::Done(result))
        }
        Err(error) => {
            // Retried after 2, 4, 8... seconds, then set aside.
            let backoff = 2f64.powi(attempts);
            db.execute(
                "UPDATE jobs SET last_error = $2,
                    state = CASE WHEN attempts >= $3 THEN 'failed' ELSE 'queued' END,
                    run_after = now() + make_interval(secs => $4)
                 WHERE id = $1",
                &[&id, &error, &MAX_ATTEMPTS, &backoff],
            )
            .await?;
            Ok(Outcome::Failed(error))
        }
    }
}
