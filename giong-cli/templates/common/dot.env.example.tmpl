# The settings of the service. In development, `giong dev` and `giong test`
# read them from .env (a copy of this file that is never committed; `giong db
# up` writes the database URLs into it). In production they come from the
# environment only.
{{#if postgres}}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{crate}}
{{/if}}
{{#if mysql}}
DATABASE_URL=mysql://root:mysql@127.0.0.1:3306/{{crate}}
{{/if}}
{{#if redis}}
REDIS_URL=redis://127.0.0.1:6379
{{/if}}
{{#if !worker}}
# This machine only: 0.0.0.0 would let anyone on the same network reach the
# service in development. The Dockerfile sets 0.0.0.0 inside the container.
LISTEN=127.0.0.1:{{default_port}}
{{/if}}
{{#if tls}}
# TLS_CERT=cert.pem
# TLS_KEY=key.pem
{{/if}}
# Workers: one per core when unset.
# WORKERS=2
{{#if web}}
# ACCESS_LOG=off
{{/if}}
# giong-mcp, so an agent can look inside the running service:
# GIONG_MCP=127.0.0.1:7777
# GIONG_MCP_TOKEN=at-least-16-characters
