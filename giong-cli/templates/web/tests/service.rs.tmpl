{{#if sql}}

#[test]
fn users_from_create_to_delete() {
{{#if sqlite}}
    let Some((state, _temp)) = state() else { return };
    let tag = run_tag();
    giong::block_on(async {
{{#else}}
    let Some(state) = state() else { return };
    let tag = run_tag();
    giong::block_on(async {
        let setup = &state.db;
        setup.batch_execute({{crate}}::SCHEMA).await.unwrap();
{{/if}}
        let (base, client) = (serve(state), client());
        let url = |path: &str| format!("{base}{path}");
        let email = format!("ada-{tag}@example.com");

        let resp = client
            .post(&url("/users"))
            .header("Content-Type", "application/json")
            .body(format!(r#"{{"name":"  Ada Lovelace ","email":"{email}"}}"#))
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 201, "{}", resp.text().unwrap());
        let created: serde_json::Value = serde_json::from_slice(resp.body()).unwrap();
        let id = created["id"].as_i64().unwrap();
        assert_eq!(resp.header("location"), Some(format!("/users/{id}").as_str()));
        assert_eq!(created["name"], "Ada Lovelace");
        assert!(created["created_at"].as_str().unwrap().ends_with('Z'));

        // The same email again is a conflict; a bad body is a 422.
        let resp = client
            .post(&url("/users"))
            .header("Content-Type", "application/json")
            .body(format!(r#"{{"name":"Ada again","email":"{email}"}}"#))
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 409);
        assert!(resp.text().unwrap().contains("\"code\":\"email_taken\""));
        let resp = client
            .post(&url("/users"))
            .header("Content-Type", "application/json")
            .body(r#"{"name":"","email":"nobody"}"#)
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 422);
        assert!(resp.text().unwrap().contains("\"code\":\"invalid_name\""));

{{#if redis}}
        let first = client.get(&url(&format!("/users/{id}"))).send().await.unwrap();
        assert_eq!(first.status(), 200);
        assert_eq!(first.header("x-cache"), Some("miss"));
        let second = client.get(&url(&format!("/users/{id}"))).send().await.unwrap();
        assert_eq!(second.header("x-cache"), Some("hit"));
        assert_eq!(first.body(), second.body());
{{#else}}
        let resp = client.get(&url(&format!("/users/{id}"))).send().await.unwrap();
        assert_eq!(resp.status(), 200);
        assert!(resp.text().unwrap().contains("\"name\":\"Ada Lovelace\""));
{{/if}}
        let resp = client.get(&url("/users/abc")).send().await.unwrap();
        assert_eq!(resp.status(), 400);

        let resp = client
            .put(&url(&format!("/users/{id}")))
            .header("Content-Type", "application/json")
            .body(format!(r#"{{"name":"Ada King","email":"{email}"}}"#))
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 200, "{}", resp.text().unwrap());
        assert!(resp.text().unwrap().contains("\"name\":\"Ada King\""));
        // The same values again: still 200, not a 404.
        let resp = client
            .put(&url(&format!("/users/{id}")))
            .header("Content-Type", "application/json")
            .body(format!(r#"{{"name":"Ada King","email":"{email}"}}"#))
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 200, "{}", resp.text().unwrap());
        let resp = client.get(&url(&format!("/users/{id}"))).send().await.unwrap();
{{#if redis}}
        assert_eq!(resp.header("x-cache"), Some("miss"));
{{/if}}
        assert!(resp.text().unwrap().contains("\"name\":\"Ada King\""));

        // Pages: the rows after `id`, in order, with a link to the next page.
        let mut ids = vec![id];
        for n in 0..3 {
            let body = format!(r#"{{"name":"User {n}","email":"user{n}-{tag}@example.com"}}"#);
            let resp = client
                .post(&url("/users"))
                .header("Content-Type", "application/json")
                .body(body)
                .send()
                .await
                .unwrap();
            assert_eq!(resp.status(), 201);
            let user: serde_json::Value = serde_json::from_slice(resp.body()).unwrap();
            ids.push(user["id"].as_i64().unwrap());
        }
        let resp = client
            .get(&url(&format!("/users?limit=2&after={}", id - 1)))
            .send()
            .await
            .unwrap();
        let page: serde_json::Value = serde_json::from_slice(resp.body()).unwrap();
        let users = page["users"].as_array().unwrap();
        assert_eq!(users.len(), 2);
        assert_eq!(users[0]["id"], id);
        assert_eq!(page["next_after"], users[1]["id"]);
        let resp = client.get(&url("/users?limit=0")).send().await.unwrap();
        assert_eq!(resp.status(), 400);

        let resp = client.get(&url("/users/export")).send().await.unwrap();
        assert_eq!(resp.status(), 200);
        assert_eq!(resp.header("content-type"), Some("application/x-ndjson"));
        let text = resp.text().unwrap();
        let exported: Vec<i64> = text
            .lines()
            .map(|l| serde_json::from_str::<serde_json::Value>(l).unwrap()["id"].as_i64().unwrap())
            .collect();
        assert!(ids.iter().all(|id| exported.contains(id)));

        for id in ids {
            let resp = client.delete(&url(&format!("/users/{id}"))).send().await.unwrap();
            assert_eq!(resp.status(), 204);
            let resp = client.get(&url(&format!("/users/{id}"))).send().await.unwrap();
            assert_eq!(resp.status(), 404);
            let resp = client.delete(&url(&format!("/users/{id}"))).send().await.unwrap();
            assert_eq!(resp.status(), 404);
        }
    });
}
{{/if}}
{{#if redis & !sql}}

#[test]
fn counters() {
    let Some(state) = state() else { return };
    let name = format!("test-{}", run_tag());
    giong::block_on(async {
        let (base, client) = (serve(state), client());
        let url = format!("{base}/counters/{name}");

        let resp = client.get(&url).send().await.unwrap();
        assert_eq!(resp.status(), 200);
        assert!(resp.text().unwrap().contains("\"value\":0"));
        let resp = client.post(&url).send().await.unwrap();
        assert_eq!(resp.status(), 200, "{}", resp.text().unwrap());
        assert!(resp.text().unwrap().contains("\"value\":1"));
        let resp = client
            .post(&url)
            .header("Content-Type", "application/json")
            .body(r#"{"by":41}"#)
            .send()
            .await
            .unwrap();
        assert!(resp.text().unwrap().contains("\"value\":42"));
        let resp = client.get(&url).send().await.unwrap();
        assert!(resp.text().unwrap().contains("\"value\":42"));

        let resp = client
            .get(&format!("{base}/counters/no%20spaces"))
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 400);
        assert!(resp.text().unwrap().contains("\"code\":\"invalid_name\""));

        let redis_url = setting("REDIS_URL").unwrap();
        let cleanup = giong_redis::Pool::new(giong_redis::Config::from_url(&redis_url).unwrap(), 1);
        assert!(cleanup.del(format!("counter:{name}")).await.unwrap());
    });
}
