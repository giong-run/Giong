{{/if}}
{{#if mysql}}
        db: giong_mysql::Pool::new(giong_mysql::Config::from_url(&db_url).unwrap(), 2),
{{/if}}
{{#if redis & sql}}
        cache: giong_redis::Pool::new(giong_redis::Config::from_url(&redis_url).unwrap(), 1),
        cache_ttl: Duration::from_secs(60),
{{/if}}
{{#if redis & !sql}}
        redis: giong_redis::Pool::new(giong_redis::Config::from_url(&redis_url).unwrap(), 1),
{{/if}}
    })
{{/if}}
}

/// A tag that makes this run's rows and keys its own.
fn run_tag() -> String {
    let nanos = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_nanos();
    format!("{}x{nanos}", std::process::id())
}
{{#else}}
fn state() -> State {
    State { greeting: "Hello" }
}
{{/if}}

/// Serves the app on a free port; the server lives as long as the test's
/// `block_on`.
fn serve(state: State) -> String {
    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
    let port = listener.local_addr().unwrap().port();
    let app = app(state, AccessLog::Off);
    giong::spawn(async move { Server::new().serve(listener, app).await });
    format!("http://127.0.0.1:{port}")
}

fn client() -> Client {
    Client::builder().timeout(Duration::from_secs(10)).build()
}

{{#if db}}
#[test]
fn health_and_ready() {
{{#if sqlite}}
    let Some((state, _temp)) = state() else { return };
{{#else}}
    let Some(state) = state() else { return };
{{/if}}
    giong::block_on(async {
        let (base, client) = (serve(state), client());
        let resp = client.get(&format!("{base}/health")).send().await.unwrap();
        assert_eq!((resp.status(), resp.text().unwrap()), (200, "ok"));
        let resp = client.get(&format!("{base}/ready")).send().await.unwrap();
        assert_eq!((resp.status(), resp.text().unwrap()), (200, "ready"));
        let resp = client.get(&format!("{base}/nothing")).send().await.unwrap();
        assert_eq!(resp.status(), 404);
        assert!(resp.text().unwrap().contains("GIONG-E"));
    });
}
{{#else}}
#[test]
fn health_hello_and_echo() {
    giong::block_on(async {
        let (base, client) = (serve(state()), client());
        let resp = client.get(&format!("{base}/health")).send().await.unwrap();
        assert_eq!((resp.status(), resp.text().unwrap()), (200, "ok"));

        let resp = client.get(&format!("{base}/hello/Ada")).send().await.unwrap();
        assert_eq!((resp.status(), resp.text().unwrap()), (200, "Hello, Ada!"));

        let resp = client
            .post(&format!("{base}/echo"))
            .header("Content-Type", "application/json")
            .body(r#"{"message":"xin chào \"giong\""}"#)
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 200);
        let body: serde_json::Value = serde_json::from_slice(resp.body()).unwrap();
        assert_eq!(body["message"], "xin chào \"giong\"");

        // Mistakes are answered with a status and a problem+json body.
        let resp = client
            .post(&format!("{base}/echo"))
            .header("Content-Type", "application/json")
            .body("{not json")
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 400);
        let resp = client
            .post(&format!("{base}/echo"))
            .header("Content-Type", "application/json")
            .body(format!(r#"{{"message":"{}"}}"#, "x".repeat(1001)))
            .send()
            .await
            .unwrap();
        assert_eq!(resp.status(), 422);
        assert!(resp.text().unwrap().contains("\"code\":\"message_too_long\""));
        let resp = client.get(&format!("{base}/nothing")).send().await.unwrap();
        assert_eq!(resp.status(), 404);
        assert!(resp.text().unwrap().contains("GIONG-E"));
    });
}
