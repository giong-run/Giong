//! The service end to end: the app served on a free port of 127.0.0.1 and
//! called with giong-http's client, the way a real client calls it.
{{#if sqlite}}
//!
//! Each test has a SQLite file of its own in the system's temporary
//! directory, deleted at the end: nothing to start, nothing shared.
{{/if}}
{{#if servers}}
//!
{{#if sqlite}}
//! It talks to the Redis named by `REDIS_URL`, from the environment or from
//! `.env` (`giong db up` writes it). Without it the tests print `SKIPPED` and
//! pass. They only touch the keys they create.
{{#else}}
//! It talks to the database and Redis named by `DATABASE_URL` and `REDIS_URL`,
//! from the environment or from `.env` (`giong db up` writes them). Without
//! them the tests that need a store print `SKIPPED` and pass. They only touch
//! the rows and keys they create, so a development database is fine.
{{/if}}
{{/if}}

use std::time::Duration;

use giong::net::TcpListener;
use giong_http::client::Client;
use giong_web::Server;
use {{crate}}::{app, AccessLog, State};

{{#if sqlite}}
/// A SQLite file of the test's own, with the tables; deleted when dropped.
struct TempDb {
    path: std::path::PathBuf,
    db: {{crate}}::db::Db,
}

impl TempDb {
    fn new() -> TempDb {
        // The tests run at once, and the clock may tick in microseconds
        // (macOS): the count keeps two files of one run apart.
        static NEXT: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let n = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
        let path = std::env::temp_dir().join(format!("{{crate}}-test-{}-{n}.db", run_tag()));
        let db = {{crate}}::db::Db::open(&path, 2).unwrap();
        db.setup({{crate}}::SCHEMA).unwrap();
        TempDb { path, db }
    }
}

impl Drop for TempDb {
    fn drop(&mut self) {
        for suffix in ["", "-wal", "-shm"] {
            let mut file = self.path.clone().into_os_string();
            file.push(suffix);
            let _ = std::fs::remove_file(file);
        }
    }
}

{{/if}}
{{#if servers}}
/// A variable from the environment, else from `.env` in the project.
fn setting(name: &str) -> Option<String> {
    if let Some(v) = std::env::var(name).ok().filter(|v| !v.is_empty()) {
        return Some(v);
    }
    let env = std::fs::read_to_string(concat!(env!("CARGO_MANIFEST_DIR"), "/.env")).ok()?;
    env.lines().find_map(|line| {
        let (key, value) = line.trim().split_once('=')?;
        let value = value.trim().trim_matches('"');
        (key.trim() == name && !value.is_empty()).then(|| value.to_string())
    })
}

