[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
giong = { {{src_giong}} }
# `web`: the routes tool, which `giong routes` and `giong openapi` ask.
giong-mcp = { {{src_giong_mcp}}, features = ["web"] }
{{#if tls}}
giong-tls = { {{src_giong_tls}} }
giong-web = { {{src_giong_web}}, features = ["serde", "tls"] }
{{#else}}
giong-web = { {{src_giong_web}}, features = ["serde"] }
{{/if}}
{{#if postgres}}
giong-postgres = { {{src_giong_postgres}} }
{{/if}}
{{#if mysql}}
giong-mysql = { {{src_giong_mysql}} }
{{/if}}
{{#if sqlite}}
# SQLite compiled in, so no system library is needed. Its calls block, so they
# run on giong's blocking lane: see src/db.rs.
rusqlite = { version = "0.43", features = ["bundled"] }
{{/if}}
{{#if redis}}
giong-redis = { {{src_giong_redis}} }
{{/if}}
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[dev-dependencies]
giong-http = { {{src_giong_http}}, features = ["client"] }

{{profiles}}
